# FastAPI
USE_MEMORY_STORE=true
DEFAULT_USER_PHONE=5511999999999
DEFAULT_TIMEZONE=America/Sao_Paulo
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase (Postgres + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Set false when Supabase credentials are configured
# USE_MEMORY_STORE=false

# OpenAI (optional — heuristic parser used without key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=dosecerta-verify

# Desktop (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mobile (Expo) — use o IP da sua máquina para celular físico
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
